# H5 cache policy.
# Upload this file to:
#   /valencia/check-in/.htaccess
# It must be next to index.html.

<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|version\.json)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>

    # IMPORTANT:
    # "Header always" also applies to 404/ErrorDocument responses.
    # This prevents a missing/hashed chunk from being cached as HTML.
    <FilesMatch "\.(js|mjs|css)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>

    Header always unset ETag
</IfModule>

DirectoryIndex index.html