# H5 cache policy.
# Upload this file to:
#   /valencia/check-in/.htaccess
# It must be next to index.html.

# Apache 2.2 / 2.4 compatible.

<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|version\.json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Avoid 304 responses for the app entry.
    Header unset ETag

</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/valencia/check-in/assets/" VU_HASHED_ASSET
</IfModule>

<IfModule mod_headers.c>
    # Vite emits content-hashed files here.
    Header set Cache-Control "public, max-age=31536000, immutable" env=VU_HASHED_ASSET
</IfModule>

DirectoryIndex index.html